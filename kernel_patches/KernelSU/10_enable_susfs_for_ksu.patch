-        }
+        ksu_queue_install_fd((int __user *)arg4);
     }
 
     return 0;
@@ -144,6 +161,7 @@ static struct kprobe reboot_kp = {
     .symbol_name = REBOOT_SYMBOL,
     .pre_handler = reboot_handler_pre,
 };
+#endif
 
