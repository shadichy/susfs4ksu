 /*
@@ -238,6 +242,107 @@ void escape_to_root_for_adb_root(void)
     }
     commit_creds(cred);
 }
+
+#ifdef CONFIG_KSU_SUSFS
+#define KERNEL_INIT_DOMAIN "u:r:init:s0"
+#define KERNEL_ZYGOTE_DOMAIN "u:r:zygote:s0"
+#define KERNEL_ZYGOTE_NEXT_DOMAIN "u:r:zygote_next:s0"
+#define KERNEL_PRIV_APP_DOMAIN "u:r:priv_app:s0:c512,c768"
+
+u32 susfs_ksu_sid __read_mostly = 0;
+u32 susfs_init_sid __read_mostly = 0;
+u32 susfs_zygote_sid __read_mostly = 0;
+u32 susfs_zygote_next_sid __read_mostly = 0;
+u32 susfs_priv_app_sid __read_mostly = 0;
+
+static inline void susfs_set_sid(const char *secctx_name, u32 *out_sid)
+{
+    int err;
+
+    if (!secctx_name || !out_sid) {
+        pr_err("secctx_name || out_sid is NULL\n");
+        return;
+    }
+
+    err = security_secctx_to_secid(secctx_name, strlen(secctx_name), out_sid);
+    if (err) {
+        pr_info("failed setting sid for '%s', err: %d\n", secctx_name, err);
+        *out_sid = 0;
+        return;
+    }
+    pr_info("sid '%u' is set for secctx_name '%s'\n", *out_sid, secctx_name);
+}
+
+bool susfs_is_sid_equal(const struct cred *cred, u32 sid2)
+{
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 18, 0)
+    const struct task_security_struct *tsec = selinux_cred(cred);
+#else
+    const struct cred_security_struct *tsec = selinux_cred(cred);
+#endif
+
+    if (!cred || !tsec || !sid2)
+        return false;
+    return tsec->sid == sid2;
+}
+
+u32 susfs_get_sid_from_name(const char *secctx_name)
+{
+    u32 out_sid = 0;
+    int err;
+
+    if (!secctx_name)
+        return 0;
+
+    err = security_secctx_to_secid(secctx_name, strlen(secctx_name), &out_sid);
+    if (err) {
+        pr_info("failed getting sid from secctx_name: %s, err: %d\n", secctx_name, err);
+        return 0;
+    }
+    return out_sid;
+}
+
+u32 susfs_get_current_sid(void)
+{
+#if LINUX_VERSION_CODE < KERNEL_VERSION(6, 18, 0)
+    const struct task_security_struct *tsec = selinux_cred(current_cred());
+#else
+    const struct cred_security_struct *tsec = selinux_cred(current_cred());
+#endif
+    if (!tsec)
+        return 0;
+    return tsec->sid;
+}
+
+bool susfs_is_current_ksu_domain(void)
+{
+    return is_ksu_domain();
+}
+
+bool susfs_is_current_init_domain(void)
+{
+    return is_init(current_cred());
+}
+
+bool susfs_is_current_zygote_domain(void)
+{
+    return likely(susfs_zygote_sid != 0) && susfs_get_current_sid() == susfs_zygote_sid;
+}
+
+bool susfs_is_current_zygote_next_domain(void)
+{
+    return likely(susfs_zygote_next_sid != 0) && susfs_get_current_sid() == susfs_zygote_next_sid;
+}
+
+void susfs_set_batch_sid(void)
+{
+    susfs_set_sid(KERNEL_ZYGOTE_DOMAIN, &susfs_zygote_sid);
+    susfs_set_sid(KERNEL_ZYGOTE_NEXT_DOMAIN, &susfs_zygote_next_sid);
+    susfs_set_sid(KERNEL_SU_CONTEXT, &susfs_ksu_sid);
+    susfs_set_sid(KERNEL_INIT_DOMAIN, &susfs_init_sid);
+    susfs_set_sid(KERNEL_PRIV_APP_DOMAIN, &susfs_priv_app_sid);
+}
+#endif
 #else
 // Check zygote/init by pathname instead
 static bool compare_exec_filename(const char *filename) {
@@ -279,4 +384,51 @@ bool is_init(const struct cred *__unused_cred) {
 bool is_adbd(const struct cred *__unused_cred) {
     return compare_exec_filename("/adbd");
 }
+
+#ifdef CONFIG_KSU_SUSFS
+u32 susfs_ksu_sid __read_mostly = 0;
+u32 susfs_init_sid __read_mostly = 0;
+u32 susfs_zygote_sid __read_mostly = 0;
+u32 susfs_zygote_next_sid __read_mostly = 0;
+u32 susfs_priv_app_sid __read_mostly = 0;
+
+void susfs_set_batch_sid(void)
+{
+}
+
+bool susfs_is_sid_equal(const struct cred *__unused_cred, u32 __unused_sid2)
+{
+    return false;
+}
+
+u32 susfs_get_sid_from_name(const char *__unused_secctx_name)
+{
+    return 0;
+}
+
+u32 susfs_get_current_sid(void)
+{
+    return 0;
+}
+
+bool susfs_is_current_ksu_domain(void)
+{
+    return is_task_ksu_domain(current_cred());
+}
+
