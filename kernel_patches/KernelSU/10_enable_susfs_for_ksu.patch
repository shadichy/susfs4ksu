diff --git a/kernel/feature/susfs_kernel_compat.c b/kernel/feature/susfs_kernel_compat.c
new file mode 100644
index 00000000..62f5fd93
--- /dev/null
+++ b/kernel/feature/susfs_kernel_compat.c
@@ -0,0 +1,102 @@
+// SPDX-License-Identifier: GPL-2.0
+/*
+ * Compatibility shims for susfs-patched kernel hooks when built with SukiSU.
+ *
+ * The susfs kernel patch series calls into a set of KSU APIs that differ from
+ * SukiSU's internal interfaces (or are not needed when SukiSU's syscall hooks
+ * handle the same functionality). Provide linkable definitions so the kernel
+ * can link; implementations are intentionally minimal/no-op where SukiSU
+ * already covers the behavior through other mechanisms.
+ */
+
+#include <linux/cred.h>
+#include <linux/fs.h>
+#include <linux/jump_label.h>
+#include <linux/mm.h>
+#include <linux/types.h>
+#include <linux/uaccess.h>
+
+/* --- static keys expected by susfs-patched kernel sites --- */
+/*
+ * Patched kernel sites declare these as static_key_true but branch with
+ * static_branch_unlikely(). Keep them disabled by default so the hooks are
+ * effectively no-op unless explicitly enabled by compatible logic.
+ */
+struct static_key_true ksu_is_init_rc_hook_enabled = { .key = STATIC_KEY_INIT_FALSE };
+struct static_key_true ksu_is_input_hook_enabled = { .key = STATIC_KEY_INIT_FALSE };
+
+/* --- VFS-level sucompat/init hooks (susfs patch API) --- */
+int ksu_handle_faccessat(int *dfd, struct filename **filename, int *mode, int *__unused_flags)
+{
+	return 0;
+}
+
+int ksu_handle_stat(int *dfd, struct filename **filename, int *flags)
+{
+	return 0;
+}
+
+void ksu_handle_vfs_fstat(int fd, loff_t *kstat_size_ptr)
+{
+}
+
+void ksu_handle_sys_read(unsigned int fd)
+{
+}
+
+/*
+ * VFS exec hooks: return non-zero to indicate "not handled as su session" so
+ * callers do not take su-session specific post-exec paths.
+ */
+int ksu_handle_execveat(int *fd, struct filename **filename_ptr, void *argv,
+			void *envp, int *flags)
+{
+	return 1;
+}
+
+int ksu_handle_execveat_sucompat(int *fd, struct filename **filename_ptr, void *argv,
+				 void *envp, int *flags)
+{
+	return 1;
+}
+
+int ksu_handle_post_execveat_sucompat(int *fd, struct filename **filename_ptr, void *argv,
+				      void *envp, int *flags, int *retval)
+{
+	return 0;
+}
+
+int ksu_setup_preinit_file(struct filename **filename_ptr, void *argv_user)
+{
+	return 0;
+}
+
+int ksu_preinit_handle_post_execveat(int *fd, struct filename **filename_ptr,
+				     void *argv_user, void *envp_user,
+				     int *flags, int *retval, int *preinit_fd)
+{
+	return 0;
+}
+
+#ifdef CONFIG_KSU_NON_ANDROID
+int ksu_handle_input_handle_event(unsigned int *type, unsigned int *code, int *value)
+{
+	return 0;
+}
+#endif
+
+#ifndef CONFIG_KSU_SELINUX
+/* selinux integration disabled: provide minimal stubs for susfs kernel hooks */
+void setup_selinux(const char *domain, struct cred *cred)
+{
+}
+
+bool ksu_selinux_hide_enabled __read_mostly = false;
+bool ksu_selinux_hide_running __read_mostly = false;
+DEFINE_STATIC_KEY_FALSE(fake_status_initialize_key);
+struct page *fake_status;
+
+void initialize_fake_status(void)
+{
+}
+#endif
